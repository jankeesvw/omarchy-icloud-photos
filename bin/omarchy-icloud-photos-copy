#!/bin/bash
# omarchy:hidden=true
# Copy image pixels as PNG, the clipboard image format browsers consume.
set -euo pipefail
umask 077

if (( $# != 1 )); then
  echo "usage: omarchy-icloud-photos-copy IMAGE" >&2
  exit 1
fi

# Finish conversion before claiming the clipboard: a failed decode should
# leave the previous clipboard intact. Only the first frame of a GIF is used.
image=$(mktemp --suffix=.png)
trap 'rm -f "$image"' EXIT
# Use fast lossless PNG compression for interactive copy.
magick "$1[0]" -auto-orient -strip -define png:compression-level=1 "png:$image"
wl-copy --type image/png < "$image"
